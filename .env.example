# LiteLLM API Key Pool (Comma-separated, at least 2 keys)
# Key ids are assigned sequentially as key_1, key_2, ...
LLM_API_KEYS=your_first_gemini_api_key_here,your_second_gemini_api_key_here

# Model name for LiteLLM (e.g. gemini/gemini-2.0-flash, gpt-4o-mini, claude-3-haiku-20240307)
LLM_MODEL=gemini/gemini-2.0-flash

# SQLite Database location (persistent Docker volume or local file path)
DATABASE_URL=sqlite:////data/app.db

# Allowed CORS origins (comma-separated or *)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enables the failover test hook (X-Simulate-Failure header support)
ENABLE_FAILURE_SIMULATION=true

# Frontend environment variable pointing to the FastAPI backend
VITE_BACKEND_URL=http://localhost:8000
